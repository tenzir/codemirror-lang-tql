{
  "name": "@tenzir/codemirror-lang-tql",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzir/codemirror-lang-tql.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "0.5.0",
  "description": "Tenzir Query Language (TQL) support for CodeMirror, backed by tree-sitter-tql",
  "keywords": [
    "codemirror",
    "tql",
    "tenzir",
    "tree-sitter"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test test/*.test.js"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "@codemirror/language": "^6.10.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/yaml": "^1.0.4",
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "tree-sitter-tql": "1.2.1",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.13"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "4.0.4"
    }
  },
  "license": "MIT",
  "packageManager": "pnpm@9.8.0+sha512.8e4c3550fb500e808dbc30bb0ce4dd1eb614e30b1c55245f211591ec2cdf9c611cabd34e1364b42f564bd54b3945ed0f49d61d1bbf2ec9bd74b866fcdc723276"
}
